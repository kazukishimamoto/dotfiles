[core]
	editor = vim -c \"set fenc=utf-8\"
	excludesfile = ~/.gitignore_global
[user]
	name = Kazuki Shimamoto
	email = jakky0529@gmail.com
[include]
  path = ~/.gitconfig-local
		# PC毎に commit 署名用の signingkey を書く
[gpg]
	program = /opt/homebrew/bin/gpg
[color]
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  grep = auto
  ui = auto
[pull]
	# pull時に不要なマージコミットを作らない
	ff = only
[alias]
	pl = pull
	ps = push
	psu = push -u origin HEAD
	st = status --short --branch
	# reset
	rs = "!git ol | fzf | awk '{print $1}' | xargs git reset"
	# stash
	su = stash -u
	sp = stash pop
	sl = stash list
	# add
	a = "!git diff --name-only | fzf --preview 'git diff --color {}' | xargs git add"
	aa = add -A
	ap = add -p
	# fetch
	fp = fetch --prune
	# 既定ブランチ（main / master）の最新状態に detach で移動する。git-release が使う
	update = "!f() { git fetch; for b in main master; do git rev-parse --verify -q origin/$b >/dev/null && { git switch -d origin/$b; return; }; done; echo 'origin/main も origin/master も見つかりません' >&2; return 1; }; f"
	# branch
	b = branch
	ba = branch --all
	bd = "!git branch | tr -d ' ' | fzf --preview 'git show --color {}' | xargs git branch -D"
	# マージ済みのブランチを一覧から選んで削除するのは .git-bin/git-vacuum（git vacuum）
	# diff
	d = diff
	ds = diff --staged
	# commit
	c = commit
	cm = commit -m
	ca = commit --amend
	# log
	l = log
	ol = log --oneline
	# switch
	nb = switch -c
	ch = "!git branch | tr -d ' ' | fzf --preview 'git show --color {}' | xargs git switch"
	dev = develop
	ft = feature
	# restore
	# add の aa / ap と同じ規則にしてある。a = 全部、p = 対話的に選ぶ
	# 作業ツリーの変更を捨てる
	ra = restore .
	rp = restore --patch
	# ステージした変更を下ろす（unstage）
	ua = restore --staged .
	up = restore --staged --patch
	# grep
	g = grep --line-number
	gu = grep --untracked --line-number
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[merge]
	ff = false
[rebase]
	autostash = true

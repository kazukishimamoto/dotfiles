#!/bin/sh
#
# 設定ファイルをホームディレクトリに配置する
#
# Homebrew の導入と brew bundle は行わない（README の手順を参照）。
# このスクリプトの責務を「配置」だけに絞ることで、TARGET を一時フォルダに
# 差し替えれば本番環境を汚さずに動作確認できる。
#   例: TARGET=/tmp/dotfiles-test sh install
#
set -eu

DOTFILES="${DOTFILES:-$HOME/dev/dotfiles}"
TARGET="${TARGET:-$HOME}"

echo "設定ファイルを配置します"
echo "  リポジトリ: $DOTFILES"
echo "  配置先:     $TARGET"
echo

link() {
  src="$DOTFILES/packages/$1"
  dst="$TARGET/$2"

  if [ ! -e "$src" ]; then
    echo "ERROR: リンク元が存在しません: $src" >&2
    return 1
  fi

  mkdir -p "$(dirname "$dst")"
  # -n が無いと、対象がディレクトリへのリンクだった場合に
  # そのディレクトリの中に入れ子でリンクが作られてしまう
  ln -sfn "$src" "$dst"
  echo "  配置: $dst"
}

# パッケージを増やしたらここに 1 行足す
link git/.gitconfig                  .gitconfig
link git/.gitignore_global           .gitignore_global
link git/.git-bin                    .git-bin
link starship/.config/starship.toml  .config/starship.toml
link tmux/.tmux.conf                 .tmux.conf
link zsh/.zshenv                     .zshenv
link zsh/.zshrc                      .zshrc
link zsh/.zshrc.d                    .zshrc.d

# .gitconfig-local は PC 毎に commit 署名用の signingkey を書くファイル。
# 既にあるものを上書きすると署名が壊れるので、絶対に触らない。
if [ -f "$TARGET/.gitconfig-local" ]; then
  echo "  保護: .gitconfig-local は既に存在するため触りません"
else
  cp "$DOTFILES/packages/git/.gitconfig-local" "$TARGET/.gitconfig-local"
  echo "  作成: .gitconfig-local （GPG の signingkey を書き込んでください）"
fi

echo
echo "完了しました。新しいシェルを開くか、exec zsh -l を実行してください。"
